{
  "expo": {
    "name": "TuQuotaAdmin",
    "slug": "tuquotaadmin-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tuquotaadmin"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.tuquotaadmin",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366f1",
          "sounds": [
            "./assets/sounds/doorbell.wav"
          ]
        }
      ]
    ],
    "extra": {
      "GOOGLE_CLIENT_ID": "63821075425-mme1ilbpmndv2dla9p6e4jkv6981mrej.apps.googleusercontent.com",
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light"
      },
      "eas": {
        "projectId": "f0d5303a-8cc9-4d2a-ae51-7a7ebf190995"
      }
    }
  }
}

{
  "expo": {
    "name": "TuQuotaAdmin",
    "slug": "tuquotaadmin-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sigpaur.tuquotaadmin"
    },
    "android": {
      "package": "com.sigpaur.tuquotaadmin",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366f1",
          "sounds": ["./assets/sounds/doorbell.wav"]
        }
      ]
    ],
    "extra": {
      "GOOGLE_CLIENT_ID": "63821075425-mme1ilbpmndv2dla9p6e4jkv6981mrej.apps.googleusercontent.com"
    }
  }
}